{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geosquare.ai/schemas/cell-dataset-manifest-v1.1.schema.json",
  "title": "GeoSquare Cell Dataset Manifest v1.1",
  "description": "Manifest 1.0 plus per-column space aggregation, extent, governance, and file hashes. Single-domain, single-level dataset. Rules that JSON Schema cannot express are listed in docs/dataset-metadata.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "dataset_type",
    "grid_system",
    "grid_version",
    "domain_code",
    "domain_id",
    "level",
    "profile_version",
    "registry_version",
    "value_fields",
    "identity",
    "coverage",
    "source",
    "extent",
    "governance",
    "storage",
    "provenance"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.1"
    },
    "dataset_type": {
      "enum": [
        "cell_values",
        "cell_contributions"
      ]
    },
    "grid_system": {
      "const": "geosquare"
    },
    "grid_version": {
      "const": "v2"
    },
    "domain_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,15}$"
    },
    "domain_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 511
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 14
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "value_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/valueField"
      }
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "extent": {
      "$ref": "#/$defs/extent"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "valueField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parquet_type",
        "logical_type",
        "semantics",
        "unit",
        "nullable",
        "aggregation_rule",
        "space_aggregation",
        "space_weight",
        "null_share",
        "min_value",
        "max_value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "not": {
            "enum": [
              "domain",
              "level",
              "gid",
              "uri",
              "packed_id",
              "x_idx",
              "y_idx",
              "source_id",
              "source_row",
              "coverage_ratio",
              "length_ratio",
              "assignment_method",
              "boundary_policy",
              "geometry_wkb"
            ]
          }
        },
        "parquet_type": {
          "type": "string",
          "minLength": 1
        },
        "logical_type": {
          "enum": [
            "numeric",
            "categorical",
            "ordinal",
            "range"
          ]
        },
        "semantics": {
          "enum": [
            "COUNT",
            "TOTAL",
            "DENSITY",
            "MEASUREMENT",
            "RATE",
            "ORDINAL",
            "CATEGORICAL",
            "RANGE"
          ]
        },
        "unit": {
          "$ref": "#/$defs/nullableString"
        },
        "nullable": {
          "type": "boolean"
        },
        "aggregation_rule": {
          "$ref": "#/$defs/nullableString"
        },
        "space_aggregation": {
          "description": "How child cells combine into a parent cell when zooming out. 'none' opts the column out of rollup.",
          "enum": [
            "sum",
            "weighted_mean",
            "majority_weighted",
            "median",
            "max",
            "min",
            "none"
          ]
        },
        "space_weight": {
          "description": "Null means each child counts equally. 'area' means child cell area. Otherwise the name of another COUNT or TOTAL value field in the same dataset.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "null_share": {
          "description": "Share of cells with a null value for this field. Computed from the data files.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "min_value": {
          "description": "Smallest non-null value. Null for non-numeric fields.",
          "type": [
            "number",
            "null"
          ]
        },
        "max_value": {
          "description": "Largest non-null value. Null for non-numeric fields.",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "semantics"
            ],
            "properties": {
              "semantics": {
                "enum": [
                  "COUNT",
                  "TOTAL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "space_aggregation": {
                "enum": [
                  "sum",
                  "none"
                ]
              },
              "space_weight": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "semantics"
            ],
            "properties": {
              "semantics": {
                "const": "DENSITY"
              }
            }
          },
          "then": {
            "properties": {
              "space_aggregation": {
                "enum": [
                  "weighted_mean",
                  "none"
                ]
              },
              "space_weight": {
                "const": "area"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "semantics"
            ],
            "properties": {
              "semantics": {
                "const": "MEASUREMENT"
              }
            }
          },
          "then": {
            "properties": {
              "space_aggregation": {
                "enum": [
                  "weighted_mean",
                  "median",
                  "max",
                  "min",
                  "none"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "semantics"
            ],
            "properties": {
              "semantics": {
                "const": "RATE"
              }
            }
          },
          "then": {
            "properties": {
              "space_aggregation": {
                "enum": [
                  "weighted_mean",
                  "none"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "semantics"
            ],
            "properties": {
              "semantics": {
                "const": "CATEGORICAL"
              }
            }
          },
          "then": {
            "properties": {
              "space_aggregation": {
                "enum": [
                  "majority_weighted",
                  "none"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "semantics"
            ],
            "properties": {
              "semantics": {
                "const": "ORDINAL"
              }
            }
          },
          "then": {
            "properties": {
              "space_aggregation": {
                "enum": [
                  "max",
                  "min",
                  "none"
                ]
              },
              "space_weight": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "semantics"
            ],
            "properties": {
              "semantics": {
                "const": "RANGE"
              }
            }
          },
          "then": {
            "properties": {
              "space_aggregation": {
                "const": "none"
              },
              "space_weight": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "space_aggregation"
            ],
            "properties": {
              "space_aggregation": {
                "const": "weighted_mean"
              }
            }
          },
          "then": {
            "properties": {
              "space_weight": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "space_aggregation"
            ],
            "properties": {
              "space_aggregation": {
                "enum": [
                  "sum",
                  "median",
                  "max",
                  "min"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "space_weight": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gid_column",
        "uri_prefix",
        "packed_id_column",
        "x_idx_column",
        "y_idx_column",
        "unique_gid"
      ],
      "properties": {
        "gid_column": {
          "const": "gid"
        },
        "uri_prefix": {
          "type": "string",
          "pattern": "^geosquare:v2:[A-Z][A-Z0-9]{0,15}:$"
        },
        "packed_id_column": {
          "$ref": "#/$defs/nullableString"
        },
        "x_idx_column": {
          "$ref": "#/$defs/nullableString"
        },
        "y_idx_column": {
          "$ref": "#/$defs/nullableString"
        },
        "unique_gid": {
          "type": "boolean"
        }
      }
    },
    "coverage": {
      "description": "How cells were assigned from source data. This is not the covered area; see extent.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_method",
        "boundary_policy",
        "boundary_sha256",
        "coverage_mode",
        "min_coverage",
        "length_mode"
      ],
      "properties": {
        "assignment_method": {
          "type": "string",
          "minLength": 1
        },
        "boundary_policy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "COVERS_POINT",
            "CENTROID_COVERED",
            "INTERSECTS",
            "MIN_COVERAGE",
            null
          ]
        },
        "boundary_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "coverage_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "GRID_PLANAR",
            "EQUAL_AREA",
            null
          ]
        },
        "min_coverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "length_mode": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "geometry_type",
        "source_crs",
        "source_id_column",
        "source_dataset",
        "source_row_count"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "geometry_type": {
          "$ref": "#/$defs/nullableString"
        },
        "source_crs": {
          "$ref": "#/$defs/nullableString"
        },
        "source_id_column": {
          "$ref": "#/$defs/nullableString"
        },
        "source_dataset": {
          "$ref": "#/$defs/nullableString"
        },
        "source_row_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "extent": {
      "description": "Area that the dataset covers. Filled by the writer from the cell list.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bbox_wgs84",
        "compact_set_path"
      ],
      "properties": {
        "bbox_wgs84": {
          "description": "[min_lon, min_lat, max_lon, max_lat] in WGS84 (EPSG:4326). Null for an empty dataset.",
          "type": [
            "array",
            "null"
          ],
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "compact_set_path": {
          "description": "Path to a compact cell set file, relative to the dataset directory. Null when none was written.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?!/).+$"
        }
      }
    },
    "governance": {
      "description": "Who owns the data, where it came from, and who may see it. Set by the person who uploads.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "owner",
        "source_name",
        "license",
        "share_policy",
        "refresh"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nullableString"
        },
        "owner": {
          "$ref": "#/$defs/nullableString"
        },
        "source_name": {
          "$ref": "#/$defs/nullableString"
        },
        "license": {
          "$ref": "#/$defs/nullableString"
        },
        "share_policy": {
          "description": "internal: never leaves the team. k_anon_only: export only through rollup with k-anonymity. public: may be shared as is.",
          "enum": [
            "internal",
            "k_anon_only",
            "public"
          ]
        },
        "refresh": {
          "description": "How often the source is expected to change. 'once' means the dataset is not updated.",
          "enum": [
            "once",
            "daily",
            "weekly",
            "monthly",
            "yearly",
            "irregular"
          ]
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parquet_compression",
        "geometry_column",
        "geometry_format",
        "geometry_crs",
        "partitioning",
        "sorted_by",
        "row_count",
        "unique_cell_count",
        "data_files"
      ],
      "properties": {
        "parquet_compression": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "zstd",
            "snappy",
            "gzip",
            "brotli",
            "uncompressed",
            null
          ]
        },
        "geometry_column": {
          "$ref": "#/$defs/nullableString"
        },
        "geometry_format": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "wkb",
            "wkt",
            "shapely",
            null
          ]
        },
        "geometry_crs": {
          "$ref": "#/$defs/nullableString"
        },
        "partitioning": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sorted_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "unique_cell_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "data_files": {
          "description": "Each Parquet file with its SHA-256. Used to detect changes and to pin snapshots.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "row_count"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)data/.+\\.parquet$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "row_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "generator",
        "aggregation_rule",
        "value_semantics",
        "notes",
        "spec_version",
        "derived_from"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "aggregation_rule": {
          "$ref": "#/$defs/nullableString"
        },
        "value_semantics": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "COUNT",
            "TOTAL",
            "DENSITY",
            "MEASUREMENT",
            "RATE",
            "ORDINAL",
            "CATEGORICAL",
            "RANGE",
            null
          ]
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        },
        "spec_version": {
          "description": "Version of the GeoSquare spec the writer followed, for example 2.0.",
          "type": "string",
          "minLength": 1
        },
        "derived_from": {
          "description": "Dataset IDs, crosswalk IDs, or source file names this dataset was built from.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
